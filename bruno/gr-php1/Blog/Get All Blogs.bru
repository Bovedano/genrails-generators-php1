meta {
  name: Get All Blogs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/blogs
  body: none
  auth: inherit
}

params:query {
  ~title: hellr
  ~user_id: 1
  ~created_at_from: 2024-01-01
  ~created_at_to: 2024-12-31
  ~_size: 2
  ~_page: 1
  ~_sort: title
  ~_order: desc
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/_auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "john@example.com",
    "password": "secret123"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

settings {
  encodeUrl: true
  timeout: 0
}
